{
  // IDE-only tsconfig for the test folder.
  // Root tsconfig.json excludes src/tests to prevent test files from being compiled into /dist (intentional).
  // Test files import describe/it/expect/vi explicitly from "vitest" (no globals), so no special
  // test-framework types are needed here anymore — this file only exists to re-include the folder.
  // It does NOT affect the production build.
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "types": ["node"]
  },
  "include": ["**/*.ts"],
  "exclude": ["../../node_modules", "../../dist"]
}
